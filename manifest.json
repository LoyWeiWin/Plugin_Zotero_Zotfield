{
  "manifest_version": 2,
  "name": "ZotFields",
  "version": "1.0.1",
  "description": "Editable research metadata: reading status, foundational papers, methods and custom fields.",
  "author": "Wei Win Loy",
  "applications": {
    "zotero": {
      "id": "zotfields@loy.local",
      "strict_min_version": "7.0.10",
      "strict_max_version": "10.0.*",
      "update_url": "https://zotfields.invalid/updates.json"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
